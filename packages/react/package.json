{
  "name": "@tern/react",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "tern react — react-reconciler custom renderer for tern",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "deno check src/index.ts",
    "check:tsc": "tsc --noEmit",
    "test": "deno test --allow-env=NODE_ENV src",
    "build": "tsc -p tsconfig.build.json && node ../../tools/fix-dts.mjs dist",
    "build:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@tern/core": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3",
    "@types/react-reconciler": "^0.33.0"
  }
}
