{
  "name": "@tern/examples",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "tern examples — runnable demos for the tern TUI renderers",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react-demo": "./react-demo.ts",
    "./solid-demo": "./solid-demo.ts",
    "./kitchen-sink-react": "./kitchen-sink-react.ts",
    "./kitchen-sink-solid": "./kitchen-sink-solid.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*_test.ts",
    "react-demo.ts",
    "solid-demo.ts",
    "kitchen-sink-react.ts",
    "kitchen-sink-solid.ts",
    "run-smoke.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "deno check src/index.ts",
    "check:tsc": "tsc --noEmit",
    "test": "deno test src",
    "build": "deno task build",
    "build:tsc": "tsc --noEmit",
    "demo:react": "deno run --allow-all react-demo.ts",
    "demo:solid": "deno run --allow-all solid-demo.ts",
    "demo:kitchen-react": "deno run --allow-all kitchen-sink-react.ts",
    "demo:kitchen-solid": "deno run --allow-all kitchen-sink-solid.ts",
    "smoke": "bash run-smoke.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
