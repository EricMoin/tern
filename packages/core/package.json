{
  "name": "@tern/core",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "tern core — TypeScript bindings for the tern TUI engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "tern-node": "0.1.0"
  },
  "scripts": {
    "check": "deno check src/index.ts",
    "check:tsc": "tsc --noEmit",
    "test": "deno test src",
    "build": "tsc -p tsconfig.build.json && node ../../tools/fix-dts.mjs dist",
    "build:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
