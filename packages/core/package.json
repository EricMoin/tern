{
  "name": "@tern/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "tern core — TypeScript bindings for the tern TUI engine",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*_test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "deno check src/index.ts",
    "check:tsc": "tsc --noEmit",
    "test": "deno test src",
    "build": "deno task build",
    "build:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
