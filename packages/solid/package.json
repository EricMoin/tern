{
  "name": "@tern-tui/solid",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "description": "tern solid \u2014 SolidJS custom renderer for tern",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricMoin/tern.git",
    "directory": "packages/solid"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "deno check src/index.ts",
    "check:tsc": "tsc --noEmit",
    "test": "deno test src",
    "build": "tsc -p tsconfig.build.json && node ../../tools/fix-dts.mjs dist",
    "build:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "solid-js": "^1.9.14",
    "@tern-tui/core": "^0.2.0"
  }
}